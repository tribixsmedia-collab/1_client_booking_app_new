<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      There is no values-night variant on purpose. The app itself is
      light-only (buildAppTheme pins Brightness.light), so following the
      system into dark here just produced a black flash in front of a white
      app on a phone set to dark mode.
    -->
    <!-- Applied to the window while the process starts. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:isLightTheme">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!--
      Applied once the process has started, and left behind the Flutter UI
      while it runs. Pinned to the same white rather than ?android:colorBackground:
      that attribute is black in dark mode, which showed as a black frame in
      the gap between the splash ending and Flutter's first paint.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <!--
          Without this, a phone in system dark mode inverts the white above to
          near-black. Flutter draws its own surface and is unaffected, so the
          result was a dark window for as long as the engine took to start,
          then a jump straight to the white splash.
        -->
        <item name="android:isLightTheme">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
